# Copy to .env.local and fill in. Never commit real values.

# Convex: written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Hexclave (formerly Stack Auth): project id from app.hexclave.com
# Also set it on Convex: npx convex env set HEXCLAVE_PROJECT_ID <id>
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=

# Gemini: server only (never prefix with NEXT_PUBLIC_). https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Salt for hashing visitor IPs into rate-limit keys (views, reports). Server only. Any long random string.
# Without it, public writes are refused in production.
RATE_LIMIT_SALT=
# Stage 2 feature flag
STACKS_ENABLED=false
