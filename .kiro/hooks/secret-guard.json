{
  "version": "v1",
  "hooks": [
    {
      "name": "Secret guard",
      "trigger": "PostFileSave",
      "description": "After a save, fails if an API key or the private planning document is in a tracked file.",
      "matcher": "^(?!.*\\.env\\.local$).*\\.(ts|tsx|js|mjs|json|md|yml|yaml)$",
      "action": {
        "type": "command",
        "command": "node scripts/pre-submit.mjs --secrets-only",
        "timeout": 60
      }
    }
  ]
}